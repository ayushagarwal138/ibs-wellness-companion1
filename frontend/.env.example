# =============================================================================
# IBS Wellness Companion Frontend Configuration
# =============================================================================
# Copy this file to .env.local and update with your actual values
# Note: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# API timeout settings (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_RETRY_ATTEMPTS=3

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXT_PUBLIC_AUTH_PROVIDER=oauth2

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# FIREBASE CONFIGURATION (CLIENT-SIDE)
# =============================================================================
# Firebase client configuration (all exposed to browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# ANALYTICS AND TRACKING
# =============================================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTAG_ID=GT-XXXXXXXXX

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# App metadata (exposed to browser)
NEXT_PUBLIC_APP_NAME="IBS Wellness Companion"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_DESCRIPTION="AI-powered IBS management platform"

# Environment
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_DEBUG=false

# =============================================================================
# UI/UX CONFIGURATION
# =============================================================================
# Pagination settings
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=10
NEXT_PUBLIC_MAX_PAGE_SIZE=50

# File upload limits (bytes)
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,txt,csv

# Chart and visualization settings
NEXT_PUBLIC_CHART_ANIMATION_DURATION=750
NEXT_PUBLIC_CHART_COLORS=#3B82F6,#10B981,#F59E0B,#EF4444,#8B5CF6,#06B6D4

# Dashboard refresh intervals (milliseconds)
NEXT_PUBLIC_DASHBOARD_REFRESH_INTERVAL=300000
NEXT_PUBLIC_REALTIME_UPDATE_INTERVAL=5000

# UI delays and timeouts (milliseconds)
NEXT_PUBLIC_UI_DELAY_SHORT=100
NEXT_PUBLIC_UI_DELAY_MEDIUM=500
NEXT_PUBLIC_SYNC_CHECK_INTERVAL=30000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features (exposed to browser)
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_CHATBOT=true
NEXT_PUBLIC_ENABLE_ML_PREDICTIONS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# CDN and asset URLs
NEXT_PUBLIC_CDN_URL=https://cdn.ibswellness.com
NEXT_PUBLIC_ASSETS_URL=https://assets.ibswellness.com

# Map services (if used)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development-only settings (not exposed to browser)
ANALYZE=false
BUNDLE_ANALYZE=false

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Content Security Policy settings
NEXT_PUBLIC_CSP_REPORT_URI=https://your-domain.com/api/csp-report

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Image optimization
NEXT_PUBLIC_IMAGE_DOMAINS=localhost,your-domain.com,firebasestorage.googleapis.com
NEXT_PUBLIC_IMAGE_QUALITY=75

# =============================================================================
# MONITORING AND ERROR TRACKING
# =============================================================================
# Error tracking (if using services like Sentry)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Performance monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=false

# =============================================================================
# LOCALIZATION
# =============================================================================
# Default language and supported locales
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es,fr

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test environment settings (not exposed to browser)
NEXT_PUBLIC_TEST_MODE=false
NEXT_PUBLIC_MOCK_API=false
