[flake8]
# Configuration for flake8 linting

# Maximum line length (more lenient for string literals)
max-line-length = 120

# Ignore specific error codes
ignore = 
    E203,
    W503,
    F841,
    F401

# Exclude directories
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .env,
    migrations,
    alembic