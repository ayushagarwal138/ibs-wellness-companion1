# =============================================================================
# IBS Wellness Companion Backend Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# CRITICAL: Change all default values in production!

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="IBS Wellness Companion API"
VERSION="1.0.0"
DESCRIPTION="AI-powered IBS management platform with predictive analytics and personalized recommendations"
DEBUG=false
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_BASE_URL=http://localhost:8000

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CRITICAL: Change these in production!
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
ALGORITHM=HS256

# Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection URL (use postgresql+asyncpg:// for async)
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/ibs_wellness
TEST_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/ibs_wellness_test
DATABASE_ECHO=false
DATABASE_TIMEOUT=30

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# CORS AND SECURITY
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@ibswellness.com
EMAILS_FROM_NAME="IBS Wellness Companion"

# SendGrid (alternative to SMTP)
SENDGRID_API_KEY=your-sendgrid-api-key

# =============================================================================
# MACHINE LEARNING CONFIGURATION
# =============================================================================
ML_MODEL_PATH=models/
ENABLE_ML_PREDICTIONS=true
ML_TRAINING_BATCH_SIZE=10
ML_TRAINING_BATCH_TIMEOUT=300
ML_TRAINING_QUEUE_TIMEOUT=60
ML_TRAINING_RETRY_DELAY=10

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# =============================================================================
# CHROMADB CONFIGURATION
# =============================================================================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=ibs_knowledge

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,txt,csv

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# RATE LIMITING AND PERFORMANCE
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100
HTTP_TIMEOUT=30

# =============================================================================
# PAGINATION SETTINGS
# =============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# OAUTH CONFIGURATION
# =============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# Get these values from your Firebase project's service account key JSON file
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
FIREBASE_TYPE=service_account
FIREBASE_AUDIENCE=your-firebase-audience

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Kaggle API (for ML model training)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ibs-wellness-models

# Notifications
NOTIFICATION_MAX_RETRIES=3

# =============================================================================
# DEVELOPMENT/TESTING SETTINGS
# =============================================================================
# Test user credentials (development only - DO NOT use in production)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!